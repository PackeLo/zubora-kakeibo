    {
      "name": "createEntrySource",
      "description": "レシート等を確認待ちの下書きとして登録する。確定や集計反映は行わない。同じ再送には同じidempotencyKeyを指定する。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "manual",
              "receipt",
              "order_detail",
              "credit_card_statement",
              "bank_statement",
              "handwritten_note",
              "other"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceFileName": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceSha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "rawInputSummary": {
            "type": [
              "string",
              "null"
            ]
          },
          "rawText": {
            "type": [
              "string",
              "null"
            ]
          },
          "rawPayloadJson": {},
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entryType": {
                  "type": "string",
                  "enum": [
                    "expense",
                    "income"
                  ]
                },
                "subjectUserId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "entryDate": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "amount": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currency": {
                  "default": "JPY",
                  "type": "string"
                },
                "target": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "categoryCodeGuess": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "categoryNameGuess": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "memo": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "entryType"
              ]
            }
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sourceType",
          "items"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entrySourceId": {
            "type": "string"
          },
          "createdEntrySourceItemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "entrySourceId",
          "createdEntrySourceItemIds",
          "status"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
