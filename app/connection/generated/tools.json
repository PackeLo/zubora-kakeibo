{
  "instructions": "家族の家計簿。分類前にgetTaxonomy、所有者を指定する前にlistUsersを呼ぶ。日付・金額が不明なら推測せず質問する。createEntrySourceは確認待ちの下書きを作る。確定は管理画面で行う。変更前に対象・変更内容を確認し、削除はIDと名前を提示して明示的な同意を得る。使用中のカテゴリ・タグと金融資産の削除は無効化になる。成功応答のIDと結果を確認して案内し、失敗した操作を成功扱いにしない。同じ取り込みの再送には同じidempotencyKeyを使う。",
  "tools": [
    {
      "name": "getTaxonomy",
      "description": "有効なカテゴリ・タグを取得する。管理用にはincludeInactiveで無効な分類も取得できる。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "includeInactive": {
            "default": false,
            "type": "boolean"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "expense",
                    "income"
                  ]
                },
                "sortOrder": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "dedupeEnabled": {
                  "type": "boolean"
                },
                "isActive": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "code",
                "name",
                "kind",
                "sortOrder",
                "dedupeEnabled",
                "isActive"
              ],
              "additionalProperties": {}
            }
          },
          "incomeCategories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "expense",
                    "income"
                  ]
                },
                "sortOrder": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "dedupeEnabled": {
                  "type": "boolean"
                },
                "isActive": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "code",
                "name",
                "kind",
                "sortOrder",
                "dedupeEnabled",
                "isActive"
              ],
              "additionalProperties": {}
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "isActive": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "isActive"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "categories",
          "incomeCategories",
          "tags"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
